# Runs on a separate, dedicated edge VPS -- NOT co-located with the app
# stack (docker-compose.prod.yml at the repo root). That split exists
# because the app VPS is a shared private box that already runs other,
# unrelated services on ports 80/443; Caddy needs those ports exclusively
# (both for ACME challenges and so on_demand_tls sees every incoming
# hostname), so it gets its own small VPS instead of fighting for them.
# Local dev doesn't use this file at all (see docker-compose.yml / .claude/launch.json).
#
# Traffic flow: internet -> this Caddy (TLS termination) -> APP_UPSTREAM_HOST
# on the app VPS, over its own published ports 3000/frontend and
# 8000/backend. See deploy/edge/README.md for the two-VPS setup this
# assumes and the firewall rule it depends on.
{
	email {$ACME_EMAIL}

	# Governs the catch-all block below: before issuing a certificate for a
	# hostname Caddy doesn't already have an explicit site block for, it asks
	# this backend endpoint (see server/app/routers/domain_router.py) whether
	# an active tenant has actually claimed that hostname as its
	# Tenant.custom_domain. A non-2xx response refuses the certificate, so a
	# stranger's domain that happens to point its DNS at this IP (without
	# ever being set as a tenant's custom_domain) can never get a cert issued
	# for it here. This now crosses the network to the app VPS -- plain HTTP,
	# not HTTPS, since the payload is just a hostname and the two VPS's are
	# expected to talk over a private network or a firewall-restricted link
	# (see deploy/edge/README.md), not the open internet.
	on_demand_tls {
		ask http://{$APP_UPSTREAM_HOST}:8000/api/v1/store/resolve-domain
		interval 2m
		burst 5
	}
}

{$APP_DOMAIN} {
	encode gzip
	header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
	reverse_proxy {$APP_UPSTREAM_HOST}:3000
}

{$API_DOMAIN} {
	encode gzip
	header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
	reverse_proxy {$APP_UPSTREAM_HOST}:8000
}

# Catch-all for tenant custom domains: any hostname that isn't $APP_DOMAIN or
# $API_DOMAIN above lands here. TLS is only issued on demand, gated by the
# `ask` check above; the frontend then rewrites the request to the right
# tenant's storefront route via proxy.ts's own resolve-domain lookup (see
# frontend/src/proxy.ts) -- Caddy and the frontend independently agree on the
# same source of truth (Tenant.custom_domain) rather than one trusting the
# other's routing decision.
:443 {
	tls {
		on_demand
	}
	encode gzip
	header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
	reverse_proxy {$APP_UPSTREAM_HOST}:3000
}
