# Copy to .env and fill in real values before running:
#   docker compose -f docker-compose.prod.yaml up -d --build
#
# For local dev (no Docker for the app itself, just mysql+redis via
# docker-compose.yml), see server/.env and frontend/.env.example instead --
# this file is only consumed by docker-compose.prod.yaml.

# --- Domains (Caddy issues real TLS certs for these via Let's Encrypt --
# they must already point at this server's IP before you start the stack) ---
# A seller's own custom domain (Tenant.custom_domain, set from their store
# settings) needs no config here at all: Caddy issues it a cert on demand and
# the frontend proxy routes it to the right store automatically, once that
# seller's DNS points it at this same server IP. See Caddyfile.
APP_DOMAIN=app.example.com
API_DOMAIN=api.example.com
ACME_EMAIL=ops@example.com

# --- Database ---
DB_ROOT_PASSWORD=change-me-to-a-long-random-value
DB_NAME=multivendor_prod

# --- Auth ---
# Must be a long random value, and byte-for-byte identical to what the
# frontend uses to verify the session JWT (see frontend/proxy.ts) --
# docker-compose.prod.yaml already wires this same value into both services.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-value

# --- Email (password reset, etc.) ---
# "console" just logs the email server-side instead of sending it -- fine
# for a first deploy, but real users can't reset a password until this is
# set to "smtp" with real credentials below.
EMAIL_PROVIDER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=noreply@example.com

# --- Payments ---
# "mock" instantly marks orders paid with zero external calls -- switch to
# "stripe" only once the keys below are real and the webhook is reachable at
# https://<API_DOMAIN>/api/v1/payments/webhook.
PAYMENT_PROVIDER=mock
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Shipping ---
# Fernet key encrypting per-tenant courier credentials at rest. Leave unset
# and that feature stays disabled; generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SHIPPING_CREDENTIALS_ENCRYPTION_KEY=

# --- Coolify tenant custom-domain automation (optional) ---
# Only relevant when deploying via docker-compose.coolify.yaml (a VPS where
# Coolify's own shared proxy already fronts other apps, so this stack can't
# run its own Caddy for on-demand TLS -- see docs/DEPLOY_COOLIFY.md). When
# both are set, a tenant setting their own custom domain automatically gets
# routed through Coolify's shared Traefik proxy (via a Traefik "dynamic
# configuration" file this app writes -- see
# server/app/services/coolify_service.py) instead of requiring an admin to
# add the domain by hand in the Coolify UI. Leave both unset to keep that
# manual step -- also the only option on docker-compose.prod.yaml, which
# already automates this via Caddy's on-demand TLS and needs none of this.
#
# Do NOT trust the defaults below without checking your own server's
# Coolify UI first (Server -> Proxy): the dynamic-config directory path and
# the cert resolver/entrypoint names are conventions, not guarantees, and
# getting them wrong fails silently (the file loads, Traefik just never
# matches/certs the domain) -- see docs/DEPLOY_COOLIFY.md step 5.
TRAEFIK_DYNAMIC_CONFIG_HOST_DIR=/data/coolify/proxy/dynamic
TRAEFIK_DYNAMIC_CONFIG_PATH=/coolify-proxy-dynamic/multivendor-tenants.yaml
TRAEFIK_CERT_RESOLVER=letsencrypt
TRAEFIK_HTTPS_ENTRYPOINT=https

# --- AI copilot (optional) ---
GEMINI_API_KEY=

# --- Error tracking (optional) ---
# Leave unset and the backend just logs unhandled exceptions instead --
# fine for a course project, not something you'll notice broke in real
# production until a user reports it. https://sentry.io's free tier (5k
# events/month) covers this easily. Create a project there (platform:
# FastAPI/Python) and paste its DSN here.
SENTRY_DSN=

# --- File storage ---
# "local" (default) writes uploads to disk in the backend container/volume --
# zero setup, but doesn't survive swapping to a new host and can't be shared
# across more than one backend instance. "s3" uploads to any S3-compatible
# bucket instead. Cloudflare R2 has a free tier (10GB storage, zero egress
# fees, unlike AWS S3) and needs no code changes here -- just fill in the
# 5 values below:
#   S3_ENDPOINT_URL      -> https://<account_id>.r2.cloudflarestorage.com
#   S3_BUCKET             -> the bucket name you created
#   S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY -> from an R2 API token
#   S3_PUBLIC_URL_BASE     -> the bucket's public r2.dev URL (or a custom
#                             domain/CDN in front of it), no trailing slash
STORAGE_TYPE=local
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL_BASE=
