# APP CONFIG
APP_ENV=development
SECRET_KEY=super_secret_random_string_change_me_in_prod
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# DATABASE (MySQL Async)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=rootpassword
DB_NAME=multivendor_db
DATABASE_URL=mysql+aiomysql://root:rootpassword@localhost:3306/multivendor_db

# REDIS (Distributed Locks & Caching)
REDIS_URL=redis://localhost:6379/0

# STORAGE (local / Cloudinary / S3)
STORAGE_TYPE=local
UPLOAD_DIR=./uploads

# EMAIL / SMTP (Mailtrap or Dummy)
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_mailtrap_user
SMTP_PASSWORD=your_mailtrap_password
EMAILS_FROM_EMAIL=noreply@multivendorhub.com