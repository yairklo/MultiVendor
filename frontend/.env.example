# Copy this file to .env.local and fill in real values for local dev.

# Must share a hostname with the frontend's own origin (localhost, not
# 127.0.0.1) -- the guest-cart HttpOnly cookies are SameSite=Lax, which only
# ride along on same-site requests.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8005

# Must be byte-for-byte identical to the backend's SECRET_KEY (see the root
# .env / server/app/core/config.py). proxy.ts uses it to verify the HS256
# signature on the session JWT before letting a request into /admin,
# /super-admin, or /crm -- if this is missing or doesn't match, every one of
# those routes fails closed (redirects to login), it does not silently trust
# an unverified token.
JWT_SECRET_KEY=super_secret_random_string_change_me_in_prod
